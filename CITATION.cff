cff-version: 1.2.0
message: "Please cite the accompanying paper when using this research software."
type: software
repository-code: "https://github.com/BioAITeam/drosophila-connectome-classification-regression"
title: "Supervised Learning Through Synaptic Adaptation in a Drosophila Connectome Model for Classification and Regression"
authors:
  - family-names: "Arteaga-Arteaga"
    given-names: "Harold Brayan"
  - family-names: "Bravo-Ortíz"
    given-names: "Mario Alejandro"
  - family-names: "Guillen-Rondon"
